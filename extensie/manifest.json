{
  "manifest_version": 2,
  "name": "ThunderLook",
  "version": "3.0.0",
  "description": "Thunderbird în stilul New Outlook: Light/Dark, lista de mesaje cu avatare și previzualizare, panoul de citire ca o foaie, pagina de start cu ora, vremea și mesajele cu steluță, bara de formatare.",
  "author": "Florin Avram",
  "browser_specific_settings": {
    "gecko": {
      "id": "outlook-cards@lexicon.local",
      "strict_min_version": "140.0"
    }
  },
  "permissions": [
    "storage",
    "https://api.open-meteo.com/*",
    "https://geocoding-api.open-meteo.com/*",
    "https://api.unsplash.com/*",
    "https://wallhaven.cc/*"
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "experiment_apis": {
    "outlookCards": {
      "schema": "schema.json",
      "parent": {
        "scopes": [
          "addon_parent"
        ],
        "events": [
          "startup"
        ],
        "paths": [
          [
            "outlookCards"
          ]
        ],
        "script": "implementation.js"
      }
    }
  }
}