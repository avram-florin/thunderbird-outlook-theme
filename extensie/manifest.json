{
  "manifest_version": 2,
  "name": "__MSG_extName__",
  "default_locale": "en",
  "version": "3.2.0",
  "description": "__MSG_extDescription__",
  "author": "Florin Avram",
  "browser_specific_settings": {
    "gecko": {
      "id": "thunderlook@lexicon-software.ro",
      "strict_min_version": "140.0"
    }
  },
  "permissions": [
    "storage",
    "https://api.open-meteo.com/*",
    "https://geocoding-api.open-meteo.com/*",
    "https://wallhaven.cc/*"
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "experiment_apis": {
    "outlookCards": {
      "schema": "schema.json",
      "parent": {
        "scopes": [
          "addon_parent"
        ],
        "events": [
          "startup"
        ],
        "paths": [
          [
            "outlookCards"
          ]
        ],
        "script": "implementation.js"
      }
    }
  }
}