{
  "manifest_version": 2,
  "name": "__MSG_extName__",
  "default_locale": "en",
  "version": "3.2.0",
  "description": "__MSG_extDescription__",
  "author": "Florin Avram",
  "homepage_url": "https://github.com/avram-florin/thunderbird-outlook-theme",
  "icons": {
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "64": "icons/icon-64.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "thunderlook@lexicon-software.ro",
      "strict_min_version": "140.0",
      "strict_max_version": "161.*"
    }
  },
  "permissions": [
    "storage",
    "sensitiveDataUpload",
    "https://api.open-meteo.com/*",
    "https://geocoding-api.open-meteo.com/*",
    "https://wallhaven.cc/*"
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "experiment_apis": {
    "outlookCards": {
      "schema": "schema.json",
      "parent": {
        "scopes": [
          "addon_parent"
        ],
        "events": [
          "startup"
        ],
        "paths": [
          [
            "outlookCards"
          ]
        ],
        "script": "implementation.js"
      }
    }
  }
}